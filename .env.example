# =============================================================================
# DeepMesh API — Machine-specific configuration
#
# Usage:
#   cp .env.example .env
#   vim .env              # fill in paths for THIS machine
#   docker compose up -d
#
# .env is gitignored — never commit it.
# =============================================================================

# -- Model weights (host path) ------------------------------------------------
# Directory containing pytorch_model.bin (or .safetensors) from:
#   huggingface-cli download zzzrw/DeepMesh --local-dir ./weights
DEEPMESH_WEIGHTS_PATH=./weights

# -- Model weight file name inside the weights directory -----------------------
DEEPMESH_MODEL_PATH=/app/weights/pytorch_model.bin

# -- Model ID (551 = Diff_LLaMA_551M, the production 0.5B model) --------------
DEEPMESH_MODEL_ID=551

# -- HuggingFace model cache (host path) --------------------------------------
# Michelangelo encoder weights are cached here on first load.
HF_CACHE_PATH=./hf_cache

# -- CUDA arch list ------------------------------------------------------------
# "12.0" = RTX Pro 6000 only (faster build).
# Full list for multi-GPU compatibility:
# TORCH_CUDA_ARCH_LIST=8.0;8.6;8.9;9.0;10.0;12.0
TORCH_CUDA_ARCH_LIST=12.0

# -- Build parallelism ---------------------------------------------------------
MAX_JOBS=4

# -- Corporate proxy (set to empty if not needed) ------------------------------
HTTP_PROXY=
HTTPS_PROXY=

# -- Output directory (persistent storage for generated meshes) ----------------
DEEPMESH_OUTPUT_PATH=./outputs

# -- GPU assignment ------------------------------------------------------------
# Run `nvidia-smi` on the host to see available devices.
GPU_ID=0

# -- Port mapping --------------------------------------------------------------
DEEPMESH_PORT=8193

# -- Optional: HuggingFace token (for gated model repos) ----------------------
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
